{%- comment -%} Quadrant: 400x240 postcard. One glance: the art and the name. {%- endcomment -%}
{%- if show_error -%}
<div class="layout layout--col layout--center">
  <span class="title title--small text--center">{{ error_title }}</span>
</div>

{%- elsif mode == 'spec' or art_q_count == 0 -%}
<div class="layout layout--col layout--center-y layout--left gap--small">
  <span class="title title--large lg:title--xlarge text--bold" data-clamp="2">{{ machine.name }}</span>
  <div class="flex flex--row flex--wrap flex--left gap--small w--full">
    <span class="label label--large">{{ machine.manufacturer }}</span>
    <span class="label label--large {{ accent_text }}">{{ machine.year }}</span>
  </div>
  <span class="w--full label {{ muted }}" data-clamp="1">{{ machine.summary }}</span>
  {%- if show_credits and credits.size > 0 -%}
  <span class="w--full label {{ muted }}" data-clamp="1">{{ credits.first.role }}: {{ credits.first.names }}</span>
  {%- endif -%}
</div>

{%- elsif mode == 'gallery' -%}
<div class="layout layout--col gap--small">
  <div class="w--full h--[72cqh]">
    {% render "art_grid", images: images, types: art_q, count: art_q_count, fit: fit_class, medium: true, name: machine.name %}
  </div>
  <div class="flex flex--row flex--center gap--small w--full">
    <span class="w--full label label--large" data-clamp="1">{{ machine.name }}</span>
    <span class="label label--large {{ accent_text }}">{{ machine.year }}</span>
  </div>
</div>

{%- else -%}
{%- capture art_block -%}
    <div class="col--span-6 h--[100cqh]">
      {% render "art_grid", images: images, types: art_q, count: art_q_count, fit: fit_class, medium: true, name: machine.name %}
    </div>
{%- endcapture -%}
{%- capture info_block -%}
    <div class="col--span-6 flex flex--col flex--left flex--center-y gap--small">
      <span class="title title--medium lg:title--large text--bold" data-clamp="3">{{ machine.name }}</span>
      <span class="label label--large">{{ machine.manufacturer }}</span>
      <span class="label label--large {{ accent_text }}">{{ machine.year }}</span>
    </div>
{%- endcapture -%}
<div class="layout layout--row layout--left">
  <div class="grid grid--cols-12 gap h--full w--full">
    {%- if art_second -%}{{ info_block }}{{ art_block }}{%- else -%}{{ art_block }}{{ info_block }}{%- endif -%}
  </div>
</div>
{%- endif -%}

<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ pinball_icon | base64_encode }}">
  <span class="title">{{ instance_title }}</span>
  <span class="instance">{{ featured.updated_label }}</span>
</div>
