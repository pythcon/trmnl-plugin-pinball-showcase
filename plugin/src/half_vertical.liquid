{%- comment -%} Half vertical: 400x480 column. Everything stacks; playfield art fits best. {%- endcomment -%}
{%- if show_error -%}
<div class="layout layout--col layout--center gap">
  <span class="title">{{ error_title }}</span>
  <span class="description text--center">{{ error_message }}</span>
</div>

{%- elsif mode == 'spec' or art_hv_count == 0 -%}
<div class="layout layout--col layout--top layout--left gap">
  <div class="flex flex--col flex--left w--full">
    <span class="title title--xlarge lg:title--xxlarge" data-clamp="2">{{ machine.name }}</span>
    <div class="flex flex--row flex--wrap flex--left gap--small w--full">
      <span class="label label--large">{{ machine.manufacturer }}</span>
      <span class="label label--large {{ accent_text }}">{{ machine.release_label | default: machine.year }}</span>
    </div>
    <span class="w--full label {{ muted }}" data-clamp="1">{{ machine.summary }}</span>
  </div>
  {%- if show_tags and machine.tags.size > 0 -%}
  <div class="flex flex--row flex--wrap flex--left gap--small w--full">
    {%- for tag in machine.tags limit: 3 -%}<span class="label label--outline">{{ tag }}</span>{%- endfor -%}
  </div>
  {%- endif -%}
  {%- if show_credits and credits.size > 0 -%}
  <div class="divider"></div>
  {%- for credit in credits limit: 6 -%}
  <div class="flex flex--col flex--left w--full {% if forloop.index > 4 %}hidden lg:flex{% endif %}">
    <span class="label {{ muted }}">{{ credit.role }}</span>
    <span class="label label--large w--full" data-clamp="1">{{ credit.names_short | default: credit.names }}</span>
  </div>
  {%- endfor -%}
  {%- endif -%}
  {%- if show_fun_fact and fun_fact -%}
  <div class="{{ accent_fill }} p--2 w--full"><span class="w--full description description--large" data-clamp="3">{{ fun_fact }}</span></div>
  {%- endif -%}
</div>

{%- else -%}
{%- if mode == 'gallery' -%}{%- assign art_height = 'h--[72cqh]' -%}{%- else -%}{%- assign art_height = 'h--[56cqh]' -%}{%- endif -%}
{%- capture art_block -%}
  <div class="w--full {{ art_height }}">
    {% render "art_grid", images: images, types: art_hv, count: art_hv_count, fit: fit_class, medium: false, name: machine.name %}
  </div>
{%- endcapture -%}
{%- capture info_block -%}
  <div class="flex flex--col flex--left w--full">
    <span class="title title--large lg:title--xlarge" data-clamp="2">{{ machine.name }}</span>
    <div class="flex flex--row flex--wrap flex--left gap--small w--full">
      <span class="label label--large">{{ machine.manufacturer }}</span>
      <span class="label label--large {{ accent_text }}">{{ machine.year }}</span>
      {%- if machine.display_label -%}<span class="label label--large {{ muted }}">{{ machine.display_label }}</span>{%- endif -%}
    </div>
    {%- if mode != 'gallery' and show_credits and credits.size > 0 -%}
    {%- for credit in credits limit: 2 -%}
    <span class="w--full label {{ muted }}" data-clamp="1">{{ credit.role }}: {{ credit.names_short | default: credit.names }}</span>
    {%- endfor -%}
    {%- endif -%}
  </div>
{%- endcapture -%}
<div class="layout layout--col layout--top layout--left gap">
  {%- if art_second -%}{{ info_block }}{{ art_block }}{%- else -%}{{ art_block }}{{ info_block }}{%- endif -%}
</div>
{%- endif -%}

<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ pinball_icon | base64_encode }}">
  <span class="title">{{ instance_title }}</span>
  <span class="instance">{{ featured.updated_label }}</span>
</div>
