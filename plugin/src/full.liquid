{%- comment -%}
  Full screen: 800x480 (OG), 1040x780 @1.8x (X, lg:).
  The name and maker sit in a full-width header so they never truncate; art and details
  share the space below. The title bar shows when the data was fetched (viewer's zone).
{%- endcomment -%}
{%- assign long_name = false -%}{%- if machine.name.size > 40 -%}{%- assign long_name = true -%}{%- endif -%}
{%- capture header -%}
  <div class="flex flex--col flex--left w--full">
    <span class="title title--xlarge lg:title--xxlarge w--full" data-clamp="2">{{ machine.name }}</span>
    <div class="flex flex--row flex--wrap flex--left gap--small w--full">
      <span class="label label--large">{{ machine.manufacturer_full | default: machine.manufacturer }}</span>
      <span class="label label--large {{ muted }}">·</span>
      <span class="label label--large {{ accent_text }}">{{ machine.release_label | default: machine.year }}</span>
    </div>
  </div>
{%- endcapture -%}

{%- if show_error -%}
<div class="layout layout--col layout--center gap">
  <span class="title title--large">{{ error_title }}</span>
  <span class="description text--center">{{ error_message }}</span>
</div>

{%- elsif mode == 'gallery' -%}
{%- if art_full_count == 0 -%}{%- assign gallery_types = 'backglass,any' | split: ',' -%}{%- assign gallery_count = 1 -%}
{%- else -%}{%- assign gallery_types = art_full -%}{%- assign gallery_count = art_full_count -%}{%- endif -%}
{%- if images.backglass == nil and art_full_count == 0 -%}{%- assign gallery_types = 'any' | split: ',' -%}{%- endif -%}
<div class="layout layout--col layout--top gap">
  <div class="w--full {% if long_name %}h--[62cqh] lg:h--[68cqh]{% else %}h--[70cqh] lg:h--[76cqh]{% endif %}">
    {% render "art_grid", images: images, types: gallery_types, count: gallery_count, fit: fit_class, medium: false, name: machine.name %}
  </div>
  <div class="flex flex--row flex--between flex--center-y w--full gap">
    {{ header }}
    {%- if show_qr -%}
    <div class="w--[72px] h--[72px] lg:w--[112px] lg:h--[112px] no-shrink">{{ qr.url | qr_code }}</div>
    {%- endif -%}
  </div>
</div>

{%- elsif mode == 'spec' or art_full_count == 0 -%}
<div class="layout layout--col layout--top layout--left gap">
  {{ header }}
  <div class="grid grid--cols-12 gap--large w--full">
    <div class="col--span-8 flex flex--col flex--left gap">
      {%- if show_tags and machine.tags.size > 0 -%}
      <div class="flex flex--row flex--wrap flex--left gap--small w--full">
        {%- for tag in machine.tags limit: 5 -%}<span class="label label--outline">{{ tag }}</span>{%- endfor -%}
      </div>
      {%- endif -%}
      <div class="grid grid--cols-3 gap w--full">
        <div class="flex flex--col flex--left w--full"><span class="value value--small lg:value--medium" data-fit-value="true">{{ machine.type_label | default: '-' }}</span><span class="label {{ muted }}">Type</span></div>
        <div class="flex flex--col flex--left w--full"><span class="value value--small lg:value--medium" data-fit-value="true">{{ machine.display_label | default: '-' }}</span><span class="label {{ muted }}">Display</span></div>
        <div class="flex flex--col flex--left w--full"><span class="value value--small lg:value--medium">{{ machine.players | default: '-' }}</span><span class="label {{ muted }}">Players</span></div>
      </div>
      {%- if show_credits and credits.size > 0 -%}
      <div class="divider"></div>
      <div class="grid grid--cols-2 gap--small w--full">
        {%- for credit in credits limit: 8 -%}
        <div class="flex flex--col flex--left w--full {% if forloop.index > 4 %}hidden lg:flex{% endif %}">
          <span class="label {{ muted }}">{{ credit.role }}</span>
          <span class="label label--large w--full">{{ credit.names_short | default: credit.names }}</span>
        </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- if show_fun_fact and fun_fact -%}
      <div class="{{ accent_fill }} p--2 w--full"><span class="description description--large">{{ fun_fact }}</span></div>
      {%- endif -%}
    </div>
    <div class="col--span-4 flex flex--col flex--left gap">
      {%- if art_full_count > 0 -%}
      {%- assign thumb = images[art_full.first] -%}
      <img class="image image-dither {{ fit_class }} w--full h--[22cqh] lg:h--[30cqh]" src="{{ thumb.url_medium | default: thumb.url }}" alt="{{ machine.name }} artwork">
      {%- endif -%}
      {%- if show_facts -%}
      {%- for fact in facts limit: 4 -%}
      <div class="flex flex--row flex--left gap--small w--full {% if forloop.index > 2 %}hidden lg:flex{% endif %}">
        <span class="label {{ muted }} w--[80px] lg:w--[112px] no-shrink">{{ fact.label }}</span>
        <span class="label w--full">{{ fact.value }}</span>
      </div>
      {%- endfor -%}
      {%- endif -%}
      {%- if show_qr -%}
      <div class="w--[80px] h--[80px] lg:w--[128px] lg:h--[128px] no-shrink">{{ qr.url | qr_code }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- else -%}
{%- if art_full_count > 1 -%}{%- assign art_span = 'col--span-8' -%}{%- assign info_span = 'col--span-4' -%}
{%- else -%}{%- assign art_span = 'col--span-7' -%}{%- assign info_span = 'col--span-5' -%}{%- endif -%}
{%- if long_name -%}{%- assign body_height = 'h--[64cqh] lg:h--[70cqh] portrait:h--[80cqh]' -%}
{%- else -%}{%- assign body_height = 'h--[74cqh] lg:h--[78cqh] portrait:h--[84cqh]' -%}{%- endif -%}
{%- comment -%}
  Detail rows (credits + facts) that fit beside the art on OG: 5, one fewer with tags or a
  two-line name. Credits come first (up to 4); facts fill the rest. TRMNL X shows 6 + 3.
{%- endcomment -%}
{%- assign row_budget = 5 -%}
{%- if show_tags and machine.tags.size > 0 -%}{%- assign row_budget = row_budget | minus: 1 -%}{%- endif -%}
{%- if long_name -%}{%- assign row_budget = row_budget | minus: 1 -%}{%- endif -%}
{%- assign credit_rows = 0 -%}{%- if show_credits -%}{%- assign credit_rows = credits.size -%}{%- endif -%}
{%- if credit_rows > 4 -%}{%- assign credit_rows = 4 -%}{%- endif -%}
{%- if credit_rows > row_budget -%}{%- assign credit_rows = row_budget -%}{%- endif -%}
{%- assign fact_rows = row_budget | minus: credit_rows -%}
{%- capture art_block -%}
    <div class="{{ art_span }} h--full">
      {% render "art_grid", images: images, types: art_full, count: art_full_count, fit: fit_class, medium: false, name: machine.name %}
    </div>
{%- endcapture -%}
{%- capture info_block -%}
    <div class="{{ info_span }} flex flex--col flex--left gap--small h--full">
      <span class="label {{ muted }} w--full" data-clamp="1">{{ machine.summary }}</span>
      {%- if show_tags and machine.tags.size > 0 -%}
      <div class="flex flex--row flex--wrap flex--left gap--small w--full">
        {%- for tag in machine.tags limit: 4 -%}<span class="label label--outline">{{ tag }}</span>{%- endfor -%}
      </div>
      {%- endif -%}
      <div class="divider"></div>
      {%- if show_credits and credits.size > 0 -%}
      {%- for credit in credits limit: 6 -%}
      <div class="flex flex--row flex--left gap--small w--full {% if forloop.index > credit_rows %}hidden lg:flex{% endif %}">
        <span class="label {{ muted }} w--[96px] lg:w--[128px] no-shrink">{{ credit.role }}</span>
        <span class="label w--full">{{ credit.names_short | default: credit.names }}</span>
      </div>
      {%- endfor -%}
      {%- endif -%}
      {%- if show_facts and facts.size > 0 -%}
      {%- for fact in facts limit: 3 -%}
      <div class="flex flex--row flex--left gap--small w--full {% if forloop.index > fact_rows %}hidden lg:flex{% endif %}">
        <span class="label {{ muted }} w--[96px] lg:w--[128px] no-shrink">{{ fact.label }}</span>
        <span class="label w--full">{{ fact.value }}</span>
      </div>
      {%- endfor -%}
      {%- endif -%}
      <div class="flex flex--row flex--bottom gap w--full stretch-y">
        {%- if show_fun_fact and fun_fact -%}
        <div class="{{ accent_fill }} p--2 w--full"><span class="w--full description" data-clamp="2" data-clamp-lg="3">{{ fun_fact }}</span></div>
        {%- endif -%}
        {%- if show_qr -%}
        <div class="w--[72px] h--[72px] lg:w--[120px] lg:h--[120px] no-shrink">{{ qr.url | qr_code }}</div>
        {%- endif -%}
      </div>
    </div>
{%- endcapture -%}
<div class="layout layout--col layout--top layout--left gap">
  {{ header }}
  <div class="grid grid--cols-12 gap--large w--full {{ body_height }} portrait:grid--cols-1">
    {%- if art_second -%}{{ info_block }}{{ art_block }}{%- else -%}{{ art_block }}{{ info_block }}{%- endif -%}
  </div>
</div>
{%- endif -%}

<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ pinball_icon | base64_encode }}">
  <span class="title">{{ instance_title }}</span>
  <span class="instance">{{ featured.updated_label }}</span>
</div>
