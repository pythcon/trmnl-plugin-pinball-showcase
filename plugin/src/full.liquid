{%- comment -%}
  Full screen: 800x480 (OG), 1040x780 @1.8x (X, lg:).
  The name and maker sit in a full-width header so they never truncate; art and details
  share the space below. The title bar shows when the data was fetched (viewer's zone).
{%- endcomment -%}
{%- comment -%}
  TRMNL X extras (hidden on OG): `stats` are the fast facts as big numbers ("29" over
  "years old"); `x_same_year` lists other titles from the same year.
{%- endcomment -%}
{%- capture x_same_year -%}
  {%- if show_facts and same_year.size > 0 -%}
  <div class="hidden lg:flex flex--col flex--left gap--xsmall w--full">
    <span class="label label--small {{ muted }}">Also released in {{ machine.year }}</span>
    <div class="flex flex--row flex--wrap flex--left gap--small w--full">
      {%- for t in same_year limit: 4 -%}
      <span class="label">{{ t.name }}</span><span class="label {{ muted }}">{{ t.manufacturer }}{% unless forloop.last %} ·{% endunless %}</span>
      {%- endfor -%}
      {%- assign more = same_year_count | minus: 4 -%}{%- if more > 0 -%}<span class="label {{ muted }}">+{{ more }} more</span>{%- endif -%}
    </div>
  </div>
  {%- endif -%}
{%- endcapture -%}
{%- assign long_name = false -%}{%- if machine.name.size > 38 -%}{%- assign long_name = true -%}{%- endif -%}
{%- capture header -%}
  <div class="flex flex--row flex--between flex--top gap w--full">
    <div class="flex flex--col flex--left w--full">
      <div class="flex flex--row flex--wrap flex--left flex--center-y gap--small w--full">
        {%- comment -%} Clamp only long names: the clamp measures at OG size and cut short names on TRMNL X. {%- endcomment -%}
        <span class="title title--xlarge lg:title--xxlarge text--bold"{% if long_name %} data-clamp="2"{% endif %}>{{ machine.name }}</span>
        {%- if edition_badge -%}<span class="label label--large {{ badge_class }} no-shrink">{{ edition_badge }}</span>{%- endif -%}
      </div>
      <div class="flex flex--row flex--wrap flex--left gap--small w--full">
        <span class="label label--large">{{ machine.manufacturer_full | default: machine.manufacturer }}</span>
        <span class="label label--large {{ muted }}">·</span>
        <span class="label label--large {{ accent_text }}">{{ machine.release_label | default: machine.year }}</span>
        {%- if art_full_from != '' -%}
        <span class="label label--large {{ muted }}">·</span>
        <span class="label label--large {{ muted }}">Art from {{ art_full_from }}</span>
        {%- endif -%}
      </div>
    </div>
    {%- if show_qr -%}
    <div class="w--[72px] h--[72px] lg:w--[120px] lg:h--[120px] no-shrink">{{ qr.url | qr_code }}</div>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- if show_error -%}
<div class="layout layout--col layout--center gap">
  <span class="title title--large">{{ error_title }}</span>
  <span class="description text--center">{{ error_message }}</span>
</div>

{%- elsif mode == 'gallery' -%}
{%- comment -%} Gallery always shows art: "None (text only)" falls back to the automatic pick. {%- endcomment -%}
{%- if art_full_count == 0 -%}{%- assign gallery_types = 'any' | split: ',' -%}{%- assign gallery_count = 1 -%}
{%- else -%}{%- assign gallery_types = art_full -%}{%- assign gallery_count = art_full_count -%}{%- endif -%}
{%- assign x_pair_types = 'backglass,playfield' | split: ',' -%}
{%- capture x_gallery_line -%}
  <div class="hidden lg:flex flex--row flex--wrap flex--left flex--center-y gap--large w--full">
    {%- if show_credits -%}{%- for credit in credits limit: 2 -%}
    <div class="flex flex--row gap--small"><span class="label label--large {{ muted }}">{{ credit.role }}</span><span class="label label--large">{{ credit.names }}</span></div>
    {%- endfor -%}{%- endif -%}
    {%- if has_stats -%}{%- for s in stats limit: 2 -%}
    <div class="flex flex--row gap--small"><span class="label label--large">{{ s.value }}</span><span class="label label--large {{ muted }}">{{ s.label }}</span></div>
    {%- endfor -%}{%- endif -%}
    {%- if show_fun_fact and fun_fact -%}<div class="{{ accent_fill }} p--1"><span class="label label--large">{{ fun_fact }}</span></div>{%- endif -%}
  </div>
{%- endcapture -%}
{%- comment -%} TRMNL X: with the photos left on automatic, show the playfield beside the backglass. {%- endcomment -%}
{%- assign x_pair = false -%}
{%- if cfg.art_full == blank and images.backglass and images.playfield -%}{%- assign x_pair = true -%}{%- endif -%}
<div class="layout layout--col layout--top gap">
  <div class="w--full {% if x_pair %}lg:hidden {% endif %}{% if long_name %}h--[62cqh] lg:h--[62cqh]{% else %}h--[70cqh] lg:h--[68cqh]{% endif %}">
    {% render "art_grid", images: images, types: gallery_types, count: gallery_count, fit: fit_class, medium: false, name: machine.name %}
  </div>
  {%- if x_pair -%}
  <div class="w--full hidden lg:block {% if long_name %}lg:h--[62cqh]{% else %}lg:h--[68cqh]{% endif %}">
    {% render "art_grid", images: images, types: x_pair_types, count: 2, fit: fit_class, medium: false, name: machine.name, spans: '8,4' %}
  </div>
  {%- endif -%}
  {{ header }}
  {{ x_gallery_line }}
</div>

{%- elsif mode == 'spec' or art_full_count == 0 -%}
{%- comment -%}
  Spec Sheet: details in a wide left column, art and facts on the right. Like Showcase,
  the left column runs on a row budget (OG fits about 11 rows under a one-line header),
  so nothing is pushed off the screen: a long name or badge that wraps the header costs
  rows, credits wrap at ~48 characters per line here, and the tip only shows if there's
  room. TRMNL X shows everything.
{%- endcomment -%}
{%- assign spec_budget = 11 -%}
{%- assign header_chars = machine.name.size -%}
{%- if edition_badge -%}{%- assign header_chars = header_chars | plus: edition_badge.size | plus: 2 -%}{%- endif -%}
{%- if header_chars > 34 -%}{%- assign spec_budget = spec_budget | minus: 1 -%}{%- endif -%}
{%- if machine.name.size > 38 -%}{%- assign spec_budget = spec_budget | minus: 1 -%}{%- endif -%}
{%- if art_full_from != '' -%}{%- assign spec_budget = spec_budget | minus: 1 -%}{%- endif -%}
{%- assign spec_used = 3 -%}{%- comment -%} the Type / Display / Players row {%- endcomment -%}
{%- if show_tags and machine.tags.size > 0 -%}{%- assign spec_used = spec_used | plus: 1 -%}{%- endif -%}
{%- if show_editions -%}
  {%- assign edition_cost = edition_line.size | plus: 47 | divided_by: 48 -%}{%- if edition_cost > 2 -%}{%- assign edition_cost = 2 -%}{%- endif -%}
  {%- assign spec_used = spec_used | plus: edition_cost -%}
{%- endif -%}
{%- assign spec_credit_cost = 0 -%}
{%- if show_credits -%}{%- for credit in credits -%}{%- assign cost = credit.names.size | plus: 47 | divided_by: 48 -%}{%- assign spec_credit_cost = spec_credit_cost | plus: cost -%}{%- endfor -%}{%- endif -%}
{%- assign spec_fun = false -%}
{%- if show_fun_fact and fun_fact -%}{%- assign with_fun = spec_used | plus: spec_credit_cost | plus: 2 -%}{%- if with_fun <= spec_budget -%}{%- assign spec_fun = true -%}{%- endif -%}{%- endif -%}
<div class="layout layout--col layout--top layout--left gap">
  {{ header }}
  <div class="grid grid--cols-12 gap--large w--full">
    <div class="col--span-8 flex flex--col flex--left flex--top gap--small">
      <div class="grid grid--cols-3 gap w--full">
        <div class="flex flex--col flex--left w--full"><span class="value value--small lg:value--base" data-fit-value="true">{{ machine.type_label | default: '-' }}</span><span class="label {{ muted }}">Type</span></div>
        <div class="flex flex--col flex--left w--full"><span class="value value--small lg:value--base" data-fit-value="true">{{ machine.display_label | default: '-' }}</span><span class="label {{ muted }}">Display</span></div>
        <div class="flex flex--col flex--left w--full"><span class="value value--small lg:value--base">{{ machine.players | default: '-' }}</span><span class="label {{ muted }}">Players</span></div>
      </div>
      {%- if show_tags and machine.tags.size > 0 -%}
      <div class="flex flex--row flex--wrap flex--left gap--small w--full">
        {%- for tag in machine.tags limit: 5 -%}<span class="label label--outline">{{ tag }}</span>{%- endfor -%}
      </div>
      {%- endif -%}
      <div class="divider"></div>
      {%- if show_editions -%}
      <div class="flex flex--row flex--left flex--top gap--small w--full">
        <span class="label {{ muted }} w--[112px] lg:w--[128px] no-shrink">{{ editions_title }}</span>
        <span class="label w--full" data-clamp="2">{{ edition_line }}</span>
      </div>
      {%- endif -%}
      {%- if show_credits -%}
      {%- assign used = spec_used -%}
      {%- for credit in credits -%}
      {%- assign cost = credit.names.size | plus: 47 | divided_by: 48 -%}
      {%- assign used = used | plus: cost -%}
      <div class="flex flex--row flex--left flex--top gap--small w--full {% if used > spec_budget %}hidden lg:flex{% endif %}">
        <span class="label {{ muted }} w--[112px] lg:w--[128px] no-shrink">{{ credit.role }}</span>
        <span class="label w--full">{{ credit.names }}</span>
      </div>
      {%- endfor -%}
      {%- endif -%}
      {%- if show_fun_fact and fun_fact -%}
      <div class="{{ accent_fill }} p--2 w--full {% unless spec_fun %}hidden lg:block{% endunless %}"><span class="w--full label" data-clamp="2">{{ fun_fact }}</span></div>
      {%- endif -%}
    </div>
    <div class="col--span-4 flex flex--col flex--left flex--top gap--small">
      {%- if art_full_count > 0 -%}
      {%- assign thumb = images[art_full.first] -%}
      {%- if spec_budget < 11 -%}{%- assign thumb_height = 'h--[28cqh] lg:h--[36cqh]' -%}{%- else -%}{%- assign thumb_height = 'h--[34cqh] lg:h--[40cqh]' -%}{%- endif -%}
      <img class="image image-dither {{ fit_class }} w--full {{ thumb_height }}" src="{{ thumb.url_medium | default: thumb.url }}" alt="{{ machine.name }} artwork">
      {%- endif -%}
      {%- if show_facts -%}
      {%- for fact in facts limit: 3 -%}
      <div class="flex flex--row flex--left flex--top gap--small w--full {% if has_stats %}lg:hidden{% endif %}">
        <span class="label {{ muted }} w--[96px] lg:w--[128px] no-shrink">{{ fact.label }}</span>
        <span class="label w--full" data-clamp="1">{{ fact.value }}</span>
      </div>
      {%- endfor -%}
      {%- if has_stats -%}
      <div class="hidden lg:block w--full">
      <div class="grid grid--cols-2 gap w--full">
        {%- for s in stats -%}
        <div class="flex flex--col flex--left">
          <span class="value value--base">{{ s.value }}</span>
          <span class="label {{ muted }}" data-clamp="2">{{ s.label }}</span>
        </div>
        {%- endfor -%}
      </div>
      </div>
      {%- endif -%}
      {%- endif -%}
      {{ x_same_year }}
    </div>
  </div>
</div>

{%- else -%}
{%- if art_full_count > 1 -%}{%- assign art_span = 'col--span-8' -%}{%- assign info_span = 'col--span-4' -%}
{%- else -%}{%- assign art_span = 'col--span-7' -%}{%- assign info_span = 'col--span-5' -%}{%- endif -%}
{%- comment -%} On TRMNL X the body leaves room for the stats band underneath. {%- endcomment -%}
{%- if long_name -%}{%- assign body_height = 'h--[64cqh] lg:h--[54cqh] portrait:h--[80cqh]' -%}
{%- else -%}{%- assign body_height = 'h--[74cqh] lg:h--[60cqh] portrait:h--[84cqh]' -%}{%- endif -%}
{%- comment -%}
  OG has room for about 9 one-line detail rows beside the art (one fewer under a two-line
  name). Credits come first and are never shortened: a role whose names run past ~26
  characters wraps (one row per 26). The fun fact (2 rows) gives way to credits; facts
  fill whatever is left. TRMNL X shows everything.
{%- endcomment -%}
{%- assign row_budget = 9 -%}
{%- if long_name -%}{%- assign row_budget = row_budget | minus: 1 -%}{%- endif -%}
{%- assign credit_cost = 0 -%}
{%- if show_editions -%}{%- assign credit_cost = edition_rows -%}{%- endif -%}
{%- if show_credits -%}{%- for credit in credits -%}{%- assign cost = credit.names.size | plus: 25 | divided_by: 26 -%}{%- assign credit_cost = credit_cost | plus: cost -%}{%- endfor -%}{%- endif -%}
{%- assign fun_on_og = false -%}
{%- if show_fun_fact and fun_fact -%}{%- assign with_fun = credit_cost | plus: 2 -%}{%- if with_fun <= row_budget -%}{%- assign fun_on_og = true -%}{%- assign row_budget = row_budget | minus: 2 -%}{%- endif -%}{%- endif -%}
{%- capture art_block -%}
    <div class="{{ art_span }} h--full">
      {% render "art_grid", images: images, types: art_full, count: art_full_count, fit: fit_class, medium: false, name: machine.name %}
    </div>
{%- endcapture -%}
{%- capture info_block -%}
    <div class="{{ info_span }} flex flex--col flex--left flex--top gap--small h--full">
      <div class="flex flex--row flex--wrap flex--left flex--center-y gap--small w--full">
        <span class="label {{ muted }}">{{ machine.summary }}</span>
        {%- if show_tags -%}{%- for tag in machine.tags limit: 3 -%}<span class="label label--outline">{{ tag }}</span>{%- endfor -%}{%- endif -%}
      </div>
      <div class="divider"></div>
      {%- assign used = 0 -%}
      {%- if show_editions -%}
      {%- assign used = edition_rows -%}
      <div class="flex flex--row flex--left flex--top gap--small w--full">
        <span class="label {{ muted }} w--[96px] lg:w--[128px] no-shrink">{{ editions_title }}</span>
        <span class="label w--full">{{ edition_line }}</span>
      </div>
      {%- endif -%}
      {%- if show_credits -%}
      {%- for credit in credits -%}
      {%- assign cost = credit.names.size | plus: 25 | divided_by: 26 -%}
      {%- assign used = used | plus: cost -%}
      <div class="flex flex--row flex--left flex--top gap--small w--full {% if used > row_budget %}hidden lg:flex{% endif %}">
        <span class="label {{ muted }} w--[96px] lg:w--[128px] no-shrink">{{ credit.role }}</span>
        <span class="label w--full">{{ credit.names }}</span>
      </div>
      {%- endfor -%}
      {%- endif -%}
      {%- if show_facts -%}
      {%- for fact in facts limit: 3 -%}
      {%- assign used = used | plus: 1 -%}
      <div class="flex flex--row flex--left gap--small w--full {% if used > row_budget %}hidden {% if has_stats == false %}lg:flex{% endif %}{% elsif has_stats %}lg:hidden{% endif %}">
        <span class="label {{ muted }} w--[96px] lg:w--[128px] no-shrink">{{ fact.label }}</span>
        <span class="label w--full">{{ fact.value }}</span>
      </div>
      {%- endfor -%}
      {%- endif -%}
      {%- if show_fun_fact and fun_fact -%}
      <div class="stretch-y lg:hidden"></div>
      <div class="{{ accent_fill }} p--2 w--full {% unless fun_on_og %}hidden lg:block{% endunless %}"><span class="w--full label" data-clamp="2" data-clamp-lg="3">{{ fun_fact }}</span></div>
      {%- endif -%}
      {%- if has_stats -%}<div class="w--full portrait:hidden">{{ x_same_year }}</div>{%- endif -%}
    </div>
{%- endcapture -%}
<div class="layout layout--col layout--top layout--left gap">
  {{ header }}
  <div class="grid grid--cols-12 gap--large w--full {{ body_height }} portrait:grid--cols-1">
    {%- if art_second -%}{{ info_block }}{{ art_block }}{%- else -%}{{ art_block }}{{ info_block }}{%- endif -%}
  </div>
  {%- if has_stats and show_facts -%}
  {%- comment -%} TRMNL X: equal outlined stat tiles, pinned just above the title bar. {%- endcomment -%}
  <div class="stretch-y hidden lg:block portrait:hidden"></div>
  <div class="hidden lg:block portrait:hidden w--full">
    <div class="grid grid--cols-{{ stats.size }} gap w--full">
      {%- for s in stats -%}
      <div class="outline p--2 flex flex--col flex--center-x gap--xsmall">
        <span class="value value--large">{{ s.value }}</span>
        <span class="label {{ muted }} text--center">{{ s.label }}</span>
      </div>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</div>
{%- endif -%}

<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ pinball_icon | base64_encode }}">
  <span class="title">{{ instance_title }}</span>
  <span class="instance">{{ featured.updated_label }}</span>
</div>
