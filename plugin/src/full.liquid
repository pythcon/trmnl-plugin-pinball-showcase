{%- comment -%} Full screen: 800x480 (OG), 1872x1404 (X, lg:). {%- endcomment -%}
{%- if show_error -%}
<div class="layout layout--col layout--center gap">
  <span class="title title--large">{{ error_title }}</span>
  <span class="description text--center">{{ error_message }}</span>
</div>

{%- elsif mode == 'gallery' -%}
{%- if art_full_count == 0 -%}{%- assign gallery_types = 'backglass,any' | split: ',' -%}{%- assign gallery_count = 1 -%}
{%- else -%}{%- assign gallery_types = art_full -%}{%- assign gallery_count = art_full_count -%}{%- endif -%}
{%- if images.backglass == nil and art_full_count == 0 -%}{%- assign gallery_types = 'any' | split: ',' -%}{%- endif -%}
<div class="layout layout--col layout--top gap">
  <div class="w--full h--[74cqh] lg:h--[80cqh]">
    {% render "art_grid", images: images, types: gallery_types, count: gallery_count, fit: fit_class, medium: false, name: machine.name %}
  </div>
  <div class="flex flex--row flex--between flex--center-y w--full gap">
    <div class="flex flex--col flex--left w--full">
      <span class="title title--large lg:title--xlarge" data-clamp="1">{{ machine.name }}</span>
      <div class="flex flex--row flex--left gap--small">
        <span class="label">{{ machine.manufacturer }}</span>
        <span class="label {{ accent_text }}">{{ machine.year }}</span>
        {%- if machine.display_label -%}<span class="label {{ muted }}">{{ machine.display_label }}</span>{%- endif -%}
      </div>
    </div>
    {%- if show_qr -%}
    <div class="w--[56px] h--[56px] lg:w--[96px] lg:h--[96px] no-shrink">{{ qr.url | qr_code }}</div>
    {%- endif -%}
  </div>
</div>

{%- elsif mode == 'spec' or art_full_count == 0 -%}
<div class="layout layout--col layout--top layout--left">
  <div class="grid gap--large w--full">
    <div class="col--span-8 flex flex--col flex--left gap">
      <div class="flex flex--col flex--left w--full">
        <span class="label label--small {{ accent_text }}">{{ featured.label }}</span>
        <span class="title title--xlarge lg:title--xxlarge" data-clamp="2">{{ machine.name }}</span>
        <div class="flex flex--row flex--left gap--small">
          <span class="label">{{ machine.manufacturer_full | default: machine.manufacturer }}</span>
          <span class="label {{ accent_text }}">{{ machine.release_label | default: machine.year }}</span>
        </div>
      </div>
      {%- if show_tags and machine.tags.size > 0 -%}
      <div class="flex flex--row flex--wrap flex--left gap--small w--full">
        {%- for tag in machine.tags limit: 5 -%}<span class="label label--small label--outline">{{ tag }}</span>{%- endfor -%}
      </div>
      {%- endif -%}
      <div class="grid grid--cols-3 gap w--full">
        <div class="flex flex--col flex--left w--full"><span class="value value--xsmall lg:value--small" data-fit-value="true">{{ machine.type_label | default: '-' }}</span><span class="label label--small {{ muted }}">Type</span></div>
        <div class="flex flex--col flex--left w--full"><span class="value value--xsmall lg:value--small" data-fit-value="true">{{ machine.display_label | default: '-' }}</span><span class="label label--small {{ muted }}">Display</span></div>
        <div class="flex flex--col flex--left w--full"><span class="value value--xsmall lg:value--small">{{ machine.players | default: '-' }}</span><span class="label label--small {{ muted }}">Players</span></div>
      </div>
      {%- if show_credits and credits.size > 0 -%}
      <div class="divider"></div>
      <div class="grid grid--cols-2 gap--small w--full">
        {%- for credit in credits limit: 8 -%}
        <div class="flex flex--col flex--left w--full {% if forloop.index > 4 %}hidden lg:flex{% endif %}">
          <span class="label label--small {{ muted }}">{{ credit.role }}</span>
          <span class="label w--full" data-clamp="2">{{ credit.names }}</span>
        </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- if show_fun_fact and fun_fact -%}
      <div class="{{ accent_fill }} p--2 w--full"><span class="description">{{ fun_fact }}</span></div>
      {%- endif -%}
    </div>
    <div class="col--span-4 flex flex--col flex--left gap">
      {%- if art_full_count > 0 -%}
      {%- assign thumb = images[art_full.first] -%}
      <img class="image image-dither {{ fit_class }} w--full h--[30cqh]" src="{{ thumb.url_medium | default: thumb.url }}" alt="{{ machine.name }} artwork">
      {%- endif -%}
      {%- if show_facts -%}
      {%- for fact in facts limit: 4 -%}
      <div class="flex flex--col flex--left w--full {% if forloop.index > 2 %}hidden lg:flex{% endif %}">
        <span class="label label--small {{ muted }}">{{ fact.label }}</span>
        <span class="label">{{ fact.value }}</span>
      </div>
      {%- endfor -%}
      {%- endif -%}
      {%- if show_same_year and same_year.size > 0 -%}
      <div class="hidden lg:flex flex--col flex--left">
        <span class="label label--small {{ muted }}">Also from {{ machine.year }}</span>
        {%- for other in same_year limit: 3 -%}
        <span class="w--full label label--small" data-clamp="1">{{ other.name }}</span>
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- if show_qr -%}
      <div class="w--[64px] h--[64px] lg:w--[120px] lg:h--[120px]">{{ qr.url | qr_code }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- else -%}
{%- if art_full_count == 0 -%}{%- assign info_span = 'col--span-12' -%}
{%- elsif art_full_count > 1 -%}{%- assign art_span = 'col--span-8' -%}{%- assign info_span = 'col--span-4' -%}
{%- else -%}{%- assign art_span = 'col--span-7' -%}{%- assign info_span = 'col--span-5' -%}{%- endif -%}
{%- capture art_block -%}
{%- if art_full_count > 0 -%}
    <div class="{{ art_span }} h--full portrait:h--[45cqh]">
      {% render "art_grid", images: images, types: art_full, count: art_full_count, fit: fit_class, medium: false, name: machine.name %}
    </div>
{%- endif -%}
{%- endcapture -%}
{%- capture info_block -%}
    <div class="{{ info_span }} flex flex--col flex--left gap">
      <div class="flex flex--col flex--left w--full">
        <span class="label label--small {{ accent_text }}">{{ featured.label }}</span>
        <span class="title title--large lg:title--xlarge" data-clamp="2">{{ machine.name }}</span>
        <div class="flex flex--row flex--left gap--small">
          <span class="label">{{ machine.manufacturer }}</span>
          <span class="label {{ accent_text }}">{{ machine.release_label | default: machine.year }}</span>
        </div>
        <span class="w--full label label--small {{ muted }}" data-clamp="1">{{ machine.summary }}</span>
      </div>
      {%- if show_tags and machine.tags.size > 0 -%}
      <div class="flex flex--row flex--wrap flex--left gap--small w--full">
        {%- for tag in machine.tags limit: 4 -%}<span class="label label--small label--outline">{{ tag }}</span>{%- endfor -%}
      </div>
      {%- endif -%}
      {%- if show_credits and credits.size > 0 -%}
      <div class="flex flex--col flex--left w--full">
        {%- for credit in credits limit: 6 -%}
        <div class="flex flex--row flex--left gap--small w--full {% if forloop.index > 3 %}hidden lg:flex portrait:flex{% endif %}">
          <span class="label label--small {{ muted }} w--[72px] lg:w--[128px] no-shrink">{{ credit.role }}</span>
          <span class="label label--small w--full" data-clamp="2">{{ credit.names }}</span>
        </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- if show_facts and facts.size > 0 -%}
      <div class="hidden lg:flex flex--col flex--left w--full">
        {%- for fact in facts limit: 3 -%}
        <div class="flex flex--row flex--left gap--small w--full">
          <span class="label label--small {{ muted }} w--[128px] no-shrink">{{ fact.label }}</span>
          <span class="label label--small w--full">{{ fact.value }}</span>
        </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
      <div class="flex flex--row flex--bottom gap w--full stretch-y">
        {%- if show_fun_fact and fun_fact -%}
        <div class="{{ accent_fill }} p--2 w--full"><span class="w--full description" data-clamp="3">{{ fun_fact }}</span></div>
        {%- endif -%}
        {%- if show_qr -%}
        <div class="w--[64px] h--[64px] lg:w--[120px] lg:h--[120px] no-shrink">{{ qr.url | qr_code }}</div>
        {%- endif -%}
      </div>
    </div>
{%- endcapture -%}
<div class="layout layout--col layout--top layout--left">
  <div class="grid gap--large w--full h--full portrait:grid--cols-1">
    {%- if art_second -%}{{ info_block }}{{ art_block }}{%- else -%}{{ art_block }}{{ info_block }}{%- endif -%}
  </div>
</div>
{%- endif -%}

<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ pinball_icon | base64_encode }}">
  <span class="title">{{ instance_title }}</span>
  <span class="instance">{{ instance_meta }}</span>
</div>
