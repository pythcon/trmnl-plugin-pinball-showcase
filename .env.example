# Copy to .env (git-ignored) to override API defaults. Every setting is optional.

# Daily OPDB export; Match Play rebuilds it around 06:30 UTC.
PINBALL_OPDB_EXPORT_URL=https://mp-data.sfo3.cdn.digitaloceanspaces.com/opdb-v2.json
# When to refresh it each day (HH:MM in PINBALL_REFRESH_TIMEZONE).
PINBALL_REFRESH_TIME=00:00
PINBALL_REFRESH_TIMEZONE=America/New_York
# Re-download at startup if the cached copy is older than this.
PINBALL_MAX_AGE_HOURS=26
# Retry delay after a failed download.
PINBALL_RETRY_MINUTES=15
# Public address of this instance, used in QR codes and machine-page links.
# Empty = the address requests arrive on (works behind a proxy that forwards Host/Proto).
PINBALL_PUBLIC_URL=
# Timezone used when a request doesn't send `tz`.
PINBALL_DEFAULT_TIMEZONE=UTC
# Cache-Control max-age on showcase responses.
PINBALL_CACHE_MAX_AGE_SECONDS=300
PINBALL_LOG_LEVEL=INFO
# Host port for compose.yaml.
PINBALL_PORT=8080
