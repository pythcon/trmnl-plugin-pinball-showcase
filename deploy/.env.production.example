# Template for the repo-root .env.production (git-ignored). Fill in, then run
# scripts/load-secrets.sh to push it into GitHub secrets. See DEPLOYMENT.md.

# ---- Deploy target (each becomes its own GitHub secret) ------------------------
DEPLOY_HOST=ssh.example.com
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PATH=/opt/docker/trmnl-plugin-pinball-showcase
DEPLOY_SSH_KEY_FILE=~/.ssh/trmnlplugins-deploy

# ---- App (becomes ENV_PRODUCTION, written to the server's .env) ---------------
PINBALL_HOST_PORT=8082
PINBALL_PUBLIC_URL=https://pinball-showcase.trmnlplugins.com
PINBALL_REFRESH_TIME=00:00
PINBALL_REFRESH_TIMEZONE=America/New_York
PINBALL_DEFAULT_TIMEZONE=America/New_York
PINBALL_LOG_LEVEL=INFO
